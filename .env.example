# BotFather'dan olingan token. Hech qachon bu qiymatni commit qilmang.
BOT_TOKEN=

# Railway PostgreSQL plagin bergan ulanish satri (xom postgresql:// ko'rinishida).
DATABASE_URL=postgresql://user:password@localhost:5432/namoz_bot

# FastAPI Mini App backend porti (Railway o'zi PORT ni beradi, lokal uchun standart).
PORT=8000

# Mini App frontend manzili (Telegram WebApp uchun to'liq HTTPS URL).
MINIAPP_URL=

# Bildirishnoma rejalashtiruvchisi ishlatadigan vaqt zonasi.
TIMEZONE=Asia/Tashkent

# Sizning Telegram foydalanuvchi ID'ingiz (@userinfobot dan oling).
# Faqat shu ID /yigish_vaqtlar va /yigish_suralar buyruqlarini ishlata oladi.
ADMIN_ID=
